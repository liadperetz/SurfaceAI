# SurfaceAI Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API key (required for OpenAI provider and default judge)
OPENAI_API_KEY=sk-your-openai-api-key

# Groq API key (optional, for Groq provider)
GROQ_API_KEY=gsk_your-groq-api-key

# DeepSeek API key (optional, for DeepSeek provider)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Ollama settings (optional, defaults shown)
# SURFACEAI_OLLAMA_BASE_URL=http://localhost:11434/v1
